/*
 * Keyball61 Cirque40 first-article keymap.
 * SPDX-License-Identifier: MIT
 *
 * Pointer modes use the same layer numbers as the Keyball44 universal builds.
 */

#define BASE   0
#define NAV    1
#define SYM    2
#define MOUSE  3
#define EXPANDED 4
#define NATIVE   5
#define SCROLL   6

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
#if defined(CONFIG_KEYBALL_PEER_LAYER_SYNC)
    peer_enroll: peer_enroll {
        compatible = "keyball,behavior-peer-enroll";
        #binding-cells = <0>;
    };

    combos {
        compatible = "zmk,combos";

        enroll_left {
            timeout-ms = <50>;
            key-positions = <0 5 12 17>;
            bindings = <&peer_enroll>;
        };

        enroll_right {
            timeout-ms = <50>;
            key-positions = <6 11 18 23>;
            bindings = <&peer_enroll>;
        };
    };
#endif

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &kp ESC         &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp BSPC
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp BACKSLASH
                &kp CAPS        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT
                &kp LEFT_SHIFT  &kp Z           &kp X           &kp C           &kp V           &kp B           &kp PAGE_DOWN   &kp PAGE_UP     &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RIGHT_SHIFT
                &none           &kp LCTRL       &kp LEFT_ALT    &kp LEFT_WIN    &mo NAV          &kp SPACE       &mo MOUSE        &kp ENTER       &mo SYM          &kp RIGHT_ALT    &kp DELETE
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
                &trans          &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans          &kp HOME        &kp UP          &kp END         &trans          &kp F12
                &to BASE        &to EXPANDED    &to NATIVE      &tog SCROLL     &trans          &trans          &to BASE        &to EXPANDED    &to NATIVE      &tog SCROLL     &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &kp PAGE_DOWN   &kp PAGE_UP     &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
                &trans          &kp EXCLAMATION &kp AT_SIGN     &kp HASH        &kp DOLLAR      &kp PERCENT     &kp CARET       &kp AMPERSAND   &kp ASTERISK    &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp MINUS       &kp EQUAL       &kp LEFT_BRACKET &kp RIGHT_BRACKET &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp UNDERSCORE  &kp PLUS        &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &mkp LCLK       &mkp MCLK       &mkp RCLK       &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        expanded_layer {
            label = "EXPANDED";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        native_layer {
            label = "NATIVE";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
