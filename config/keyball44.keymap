/*
 * Keyball44 Rev1 first-article keymap.
 * SPDX-License-Identifier: MIT
 *
 * Pointer-mode layers are part of the firmware interface and must stay in sync
 * with the layer numbers in the right-half pointing-device overlays.
 */

#define BASE      0
#define NAV       1
#define SYM       2
#define MOUSE     3
#define EXPANDED  4
#define NATIVE    5
#define SCROLL    6

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "ORIGINAL";
            bindings = <
                &kp ESC         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp BSPC
                &kp TAB         &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT
                &kp LEFT_SHIFT  &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RIGHT_SHIFT
                &kp LCTRL       &lt MOUSE LEFT_ALT &kp LEFT_WIN &mo NAV         &kp SPACE       &lt MOUSE ENTER &mo SYM         &lt NAV DELETE
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
                &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR
                &kp ESC         &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp HOME        &kp END
                &to BASE        &to EXPANDED    &to NATIVE      &tog SCROLL     &bt BT_CLR      &trans          &to BASE        &to EXPANDED    &to NATIVE      &tog SCROLL     &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp BSPC
                &trans          &kp EXCLAMATION &kp AT_SIGN     &kp HASH        &kp DOLLAR      &kp PERCENT     &kp CARET       &kp AMPERSAND   &kp ASTERISK    &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp PIPE
                &trans          &trans          &trans          &trans          &trans          &trans          &kp MINUS       &kp EQUAL       &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp BACKSLASH   &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &mkp LCLK       &mkp MCLK       &mkp RCLK       &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        expanded_layer {
            label = "EXPANDED";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        native_layer {
            label = "NATIVE";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
