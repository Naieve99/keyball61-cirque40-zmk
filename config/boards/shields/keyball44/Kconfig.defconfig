if SHIELD_KEYBALL44_RIGHT_CIRQUE || SHIELD_KEYBALL44_RIGHT_PMW3360

config ZMK_KEYBOARD_NAME
    default "Keyball44"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config INPUT
    default y

config ZMK_POINTING
    default y

endif

if SHIELD_KEYBALL44_LEFT_STANDALONE

config ZMK_KEYBOARD_NAME
    default "KB44 Left"

endif

if SHIELD_KEYBALL44_RIGHT_CIRQUE_STANDALONE || SHIELD_KEYBALL44_RIGHT_PMW3360_STANDALONE

config ZMK_KEYBOARD_NAME
    default "KB44 Right"

config INPUT
    default y

config ZMK_POINTING
    default y

endif

if SHIELD_KEYBALL44_RIGHT_CIRQUE || SHIELD_KEYBALL44_RIGHT_CIRQUE_STANDALONE

config I2C
    default y

endif

if SHIELD_KEYBALL44_RIGHT_PMW3360 || SHIELD_KEYBALL44_RIGHT_PMW3360_STANDALONE

config SPI
    default y

endif

if SHIELD_KEYBALL44_LEFT || SHIELD_KEYBALL44_RIGHT_CIRQUE || SHIELD_KEYBALL44_RIGHT_PMW3360

config ZMK_SPLIT
    default y

