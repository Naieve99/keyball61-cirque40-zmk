config ZMK_KEYBOARD_NAME
    default "KB44 Right"

config INPUT
    default y

config ZMK_POINTING
    default y

endif

if SHIELD_KEYBALL44_RIGHT_CIRQUE_PEER || SHIELD_KEYBALL44_RIGHT_PMW3360_PEER

config ZMK_KEYBOARD_NAME
    default "KB44 R Peer"

config INPUT
    default y

config ZMK_POINTING
    default y

endif

if SHIELD_KEYBALL44_RIGHT_CIRQUE || SHIELD_KEYBALL44_RIGHT_CIRQUE_STANDALONE || SHIELD_KEYBALL44_RIGHT_CIRQUE_PEER

config I2C
    default y

endif

if SHIELD_KEYBALL44_RIGHT_PMW3360 || SHIELD_KEYBALL44_RIGHT_PMW3360_STANDALONE || SHIELD_KEYBALL44_RIGHT_PMW3360_PEER

