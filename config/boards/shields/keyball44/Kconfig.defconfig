    default y

config INPUT
    default y

config ZMK_POINTING
    default y

endif

if SHIELD_KEYBALL44_LEFT_STANDALONE

config ZMK_KEYBOARD_NAME
    default "KB44 Left"

endif

if SHIELD_KEYBALL44_LEFT_PEER

