menu "Keyball peer features"

config KEYBALL_PEER_LAYER_SYNC
	bool "Independent-half layer synchronization"
	depends on ZMK_BLE
	help
	  Keep each half as an independent host-facing ZMK keyboard while
	  broadcasting local layer state to its peer over connectionless BLE.

if KEYBALL_PEER_LAYER_SYNC

config KEYBALL_PEER_FAMILY
	int "Keyboard family identifier"
	range 1 255
	help
	  Must match on both halves. Keyball44 uses 44 and Keyball61 uses 61.

config KEYBALL_PEER_SIDE
	int "Side identifier (0 left, 1 right)"
	range 0 1
	help
	  Prevents a half from accepting packets sent by another half configured
	  for the same side.

config KEYBALL_PEER_TIMEOUT_MS
	int "Peer layer timeout in milliseconds"
	range 500 10000
	default 2500
	help
	  Remove remotely contributed layers if peer advertisements stop arriving.

config KEYBALL_PEER_ENROLL_HOLD_MS
	int "Peer enrollment chord hold time in milliseconds"
	range 1000 10000
	default 3000
	help
	  Hold the local enrollment chord this long to erase only the saved peer
	  relationship and open a new enrollment window.

config KEYBALL_PEER_ENROLL_TIMEOUT_MS
	int "Peer enrollment window in milliseconds"
	range 10000 300000
	default 60000
	help
	  Stop accepting enrollment packets if no opposite-side peer completes
	  the handshake within this interval.

config KEYBALL_PEER_ENROLL_MIN_RSSI
	int "Minimum enrollment signal strength (dBm)"
	range -100 -20
	default -55
	help
	  Ignore enrollment requests weaker than this value. Put the intended
	  halves close together while enrolling them.

config KEYBALL_PEER_INIT_PRIORITY
	int "Peer synchronization initialization priority"
	default 99
	help
	  Must run after ZMK initializes Bluetooth and its keymap.

endif

endmenu

menu "Keyball universal pointer"

config KEYBALL_UNIVERSAL_POINTER
	bool "Startup probing for Cirque I2C or PMW3360 SPI"
	depends on GPIO && I2C && SPI && INPUT
	help
	  Keep the shared pins in an input-safe state, hold PMW3360 NCS inactive,
	  and bit-bang a read-only Cirque FirmwareId probe at I2C address 0x2A.
	  If Cirque is absent, initialize SPI and verify the PMW3360 Product_ID.
	  No module-side identity straps are required.

config KEYBALL_POINTER_DETECT_INIT_PRIORITY
	int "Universal pointer detection initialization priority"
	depends on KEYBALL_UNIVERSAL_POINTER
	default 80
	help
	  APPLICATION-level priority used to select and initialize one pointer.

endmenu
